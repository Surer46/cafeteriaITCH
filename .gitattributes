# Un solo formato de fin de línea en el repositorio, sin importar qué agente edite.
* text=auto eol=lf

# Binarios
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.db binary
*.a binary
*.exe binary
*.dll binary

# Los guiones de cmd.exe necesitan CRLF: con LF fallan las etiquetas de goto.
*.cmd text eol=crlf
*.bat text eol=crlf
